package layout

templ Base(title string, body templ.Component) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<link rel="stylesheet" href="/static/css/output.css"/>
			<script src="/static/js/htmx.min.js"></script>
			<script defer src="/static/js/alpine-intersect.min.js"></script>
			<script defer src="/static/js/alpine.min.js"></script>
			<title>{ title }</title>
		</head>
		<body class="p-5 pt-24 lg:py-24 bg-brand-dom text-brand-sec">
			<header class="md:w-2/3 lg:w-1/2 mx-auto">
				<h1 class="text-4xl lg:text-7xl font-black mb-4 tracking-tight">What's up!</h1>
			</header>
			<main>
				<section class="md:w-2/3 lg:w-1/2 mx-auto mt-6">
					<div>
						<h2 class="capitalize text-lg mb-2 font-light">today's tasks</h2>
					</div>
					@body
				</section>
			</main>
			<footer class="fixed bottom-0 left-0 right-0 grid place-items-center p-2">
				<p class="capitalize text-sm">powered by <span class="font-semibold text-brand-acc">GO</span> and <span class="font-semibold text-brand-htx">HTMX</span></p>
			</footer>
		</body>
	</html>
}
